# ─── 백엔드 환경변수 예시 ───
# 이 파일을 복사해서 .env 로 만들고 값을 채우세요:  cp .env.example .env

# CORS 허용 도메인 (콤마로 구분). 배포 도메인 + 로컬 개발 주소
ALLOWED_ORIGINS=https://your-domain.example.org,http://localhost:5173

# yt-dlp 봇 차단 우회용 (선택)
# 1) 프록시 경유: 가정용 IP 프록시 주소 (없으면 비워두기)
HTTP_PROXY=
# 2) 또는 유튜브 쿠키 파일 경로 (선택, 없으면 비워두기)
YOUTUBE_COOKIES=

# yt-dlp 타임아웃(초) / 재시도 횟수
YT_API_TIMEOUT=30
MAX_RETRIES=2

# 재생목록 / 랭킹 최대 크기
MAX_PLAYLIST_SIZE=500
MAX_RANKING_SIZE=100
