[Unit]
Description=NinamamuPlayer Music Streaming Service
After=network.target

[Service]
Type=notify
User=ubuntu
WorkingDirectory=/home/ubuntu/chzzk-music-player/backend
Environment="PATH=/home/ubuntu/chzzk-music-player/backend/venv/bin"

ExecStart=/home/ubuntu/chzzk-music-player/backend/venv/bin/uvicorn \
  main:app \
  --host 127.0.0.1 \
  --port 8000 \
  --workers 4

Restart=on-failure
RestartSec=5s
StartLimitInterval=60s
StartLimitBurst=3

[Install]
WantedBy=multi-user.target
